# iroum-cms Backend — Multi-stage Dockerfile
# 빌드: docker build -f deploy/Dockerfile.backend -t iroum-cms-backend .
# 런타임: eclipse-temurin:17-jre-jammy (non-root 유저 1001)

# ────────────────────────────────────────────
# Stage 1: 빌드 (JDK 17 + Gradle)
# ────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM eclipse-temurin:17-jdk-jammy AS builder

WORKDIR /workspace

# Gradle wrapper 및 빌드 스크립트 먼저 복사 (레이어 캐시 최적화)
COPY backend/gradle gradle
COPY backend/gradlew backend/build.gradle.kts backend/settings.gradle.kts ./

# Gradle wrapper 실행 권한 부여
RUN chmod +x gradlew

# 의존성 다운로드 (소스 변경과 분리하여 캐시 활용)
RUN ./gradlew --version --no-daemon 2>/dev/null || true
RUN ./gradlew dependencies --no-daemon -q 2>/dev/null || true

# 소스 코드 복사 후 빌드 (테스트 제외 — CI에서 별도 실행)
COPY backend/src src
RUN ./gradlew bootJar --no-daemon -x test --parallel

# ────────────────────────────────────────────
# Stage 2: 런타임 (JRE 17 — 최소 이미지)
# ────────────────────────────────────────────
FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

# 보안: non-root 유저 생성 (UID 1001)
RUN groupadd -r -g 1001 iroum && \
    useradd -r -u 1001 -g iroum -s /sbin/nologin iroum

# 빌드 산출물만 복사 (소스 미포함)
COPY --from=builder /workspace/build/libs/iroum-cms.jar app.jar

# 파일 소유권 설정
RUN chown iroum:iroum app.jar

USER 1001

EXPOSE 8080

# 헬스 체크: Spring Boot Actuator health 엔드포인트 (REQ-CROSS-008-D)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q --spider http://localhost:8080/actuator/health || exit 1

# JVM 튜닝: 컨테이너 메모리 75% 사용, G1GC
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
