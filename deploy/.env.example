# iroum-cms 환경변수 예시
# 복사 후 deploy/.env 로 저장하고 실제 값으로 교체하세요.
# .env 파일은 Git에 커밋하지 마세요 (.gitignore 등록됨)

# ─── Spring Boot 프로파일 ───
SPRING_PROFILES_ACTIVE=local

# ─── 데이터베이스 ───
DB_USERNAME=iroum_cms
DB_PASSWORD=iroum_cms_dev_pwd

# ─── JWT 시크릿 (운영: 256비트 이상 랜덤 문자열 필수) ───
# 생성: openssl rand -base64 32
JWT_SECRET=replace-with-strong-secret-min-256-bit-key

# ─── SMTP (이메일 발송, SPEC-CMS-002 본인인증) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Redis (SPEC-CMS-002 캐시 활성화 시) ───
# REDIS_HOST=redis
# REDIS_PORT=6379

# ─── 외부 API (향후 확장) ───
# KAKAO_CLIENT_ID=
# NAVER_CLIENT_ID=
