<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  TokenBlacklistMapper SQL 정의 (RED 단계 — 구문만 선언, 테스트는 Mock 사용).
  SPEC-CMS-002 REQ-AUTH-003 로그아웃 토큰 블랙리스트
-->
<mapper namespace="kr.co.ircp.cms.domain.auth.repository.TokenBlacklistMapper">

    <!-- 블랙리스트 삽입 -->
    <insert id="insert" parameterType="kr.co.ircp.cms.domain.auth.entity.TokenBlacklist">
        INSERT INTO token_blacklist (token_hash, revoked_at, expires_at)
        VALUES (#{tokenHash}, #{revokedAt}, #{expiresAt})
        ON CONFLICT (token_hash) DO NOTHING
    </insert>

    <!-- 존재 여부 확인 -->
    <select id="exists" parameterType="string" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM token_blacklist
            WHERE token_hash = #{hash}
        )
    </select>

    <!-- 만료된 블랙리스트 항목 GC -->
    <delete id="deleteExpired">
        DELETE FROM token_blacklist
        WHERE expires_at &lt; #{now}
    </delete>

</mapper>
