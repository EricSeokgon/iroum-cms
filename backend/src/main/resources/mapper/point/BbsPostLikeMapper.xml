<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.ircp.cms.domain.point.mapper.BbsPostLikeMapper">

    <resultMap id="LikeRM" type="kr.co.ircp.cms.domain.point.entity.BbsPostLike">
        <id     property="id"        column="id"/>
        <result property="userId"    column="user_id"/>
        <result property="postId"    column="post_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUserIdAndPostId" resultMap="LikeRM">
        SELECT id, user_id, post_id, created_at
        FROM bbs_post_like
        WHERE user_id = #{userId} AND post_id = #{postId}
    </select>

    <insert id="insert" parameterType="kr.co.ircp.cms.domain.point.entity.BbsPostLike"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bbs_post_like (user_id, post_id)
        VALUES (#{userId}, #{postId})
    </insert>

    <delete id="deleteByUserIdAndPostId">
        DELETE FROM bbs_post_like
        WHERE user_id = #{userId} AND post_id = #{postId}
    </delete>

    <select id="countByPostId" resultType="int">
        SELECT COUNT(*) FROM bbs_post_like WHERE post_id = #{postId}
    </select>

</mapper>
