<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    페이지 이력 매퍼 XML.
    REQ-CONTENT-005-D-2/6/7: Step 2 GREEN 단계에서 실제 SQL 구현
-->
<mapper namespace="kr.co.ircp.cms.domain.content.page.mapper.PageHistoryMapper">

    <resultMap id="historyResultMap" type="kr.co.ircp.cms.domain.content.page.entity.PageHistory">
        <id     property="id"            column="id"/>
        <result property="pageId"        column="page_id"/>
        <result property="version"       column="version"/>
        <result property="snapshot"      column="snapshot"/>
        <result property="editedBy"      column="edited_by"/>
        <result property="editedAt"      column="edited_at"/>
        <result property="changeSummary" column="change_summary"/>
    </resultMap>

    <select id="findByPageId" resultMap="historyResultMap">
        SELECT * FROM page_history WHERE page_id = #{pageId} ORDER BY version DESC
    </select>

    <select id="findByPageIdAndVersion" resultMap="historyResultMap">
        SELECT * FROM page_history WHERE page_id = #{pageId} AND version = #{version}
    </select>

    <insert id="insert" parameterType="kr.co.ircp.cms.domain.content.page.entity.PageHistory"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO page_history (page_id, version, snapshot, edited_by, change_summary)
        VALUES (#{pageId}, #{version}, #{snapshot}::jsonb, #{editedBy}, #{changeSummary})
    </insert>

    <!-- REQ-PHIST-001: 페이지 이력 건수 조회 (보존 한도 초과 판단) -->
    <select id="countByPageId" resultType="int">
        SELECT COUNT(*) FROM page_history WHERE page_id = #{pageId}
    </select>

    <!-- REQ-PHIST-001: 최신 keepCount개 version 보존, 나머지 오래된 이력 삭제.
         version DESC 정렬로 보존 대상을 선정하므로 currentVersion(최대 version)은 항상 보존된다. -->
    <delete id="deleteOldestByPageId">
        DELETE FROM page_history
        WHERE page_id = #{pageId}
          AND id NOT IN (
              SELECT id FROM page_history
              WHERE page_id = #{pageId}
              ORDER BY version DESC
              LIMIT #{keepCount}
          )
    </delete>

</mapper>
