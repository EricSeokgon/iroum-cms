<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.ircp.cms.domain.dashboard.repository.KpiValueMapper">

    <resultMap id="kpiValueMap" type="kr.co.ircp.cms.domain.dashboard.entity.KpiValueRow">
        <id property="id" column="id"/>
        <result property="kpiId" column="kpi_id"/>
        <result property="dimension" column="dimension"/>
        <result property="valueNumeric" column="value_numeric"/>
        <result property="valueText" column="value_text"/>
        <result property="calculatedAt" column="calculated_at"/>
    </resultMap>

    <select id="findByKpiIdAndDimension" resultMap="kpiValueMap">
        SELECT id, kpi_id,
               dimension::text AS dimension,
               value_numeric, value_text, calculated_at
        FROM kpi_value
        WHERE kpi_id = #{kpiId}
        <if test="dimensionFilter != null">
            AND dimension @&gt; #{dimensionFilter}::jsonb
        </if>
        ORDER BY calculated_at DESC
    </select>
</mapper>
