<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    게시글 조회 이력 매퍼 XML.
    REQ-BOARD-002-D-3: view_log dedupe 후 view_count 증가
-->
<mapper namespace="kr.co.ircp.cms.domain.board.repository.BbsViewLogMapper">

    <resultMap id="bbsViewLogResultMap" type="kr.co.ircp.cms.domain.board.entity.BbsViewLog">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="ipHash" column="ip_hash"/>
        <result property="userAgentHash" column="user_agent_hash"/>
        <result property="viewedAt" column="viewed_at"/>
    </resultMap>

    <!--
        중복 조회 확인 (1시간 이내).
        로그인 사용자: userId 기준, 비로그인: ipHash 기준
    -->
    <select id="existsRecentView" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM bbs_view_log
            WHERE post_id = #{postId}
              AND viewed_at > NOW() - INTERVAL '1 hour'
              AND (
                  (#{userId} IS NOT NULL AND user_id = #{userId})
                  OR
                  (#{userId} IS NULL AND ip_hash = #{ipHash})
              )
        )
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bbs_view_log (post_id, user_id, ip_hash, user_agent_hash)
        VALUES (#{postId}, #{userId}, #{ipHash}, #{userAgentHash})
    </insert>

</mapper>
