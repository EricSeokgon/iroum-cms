<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    댓글 매퍼 XML.
    REQ-BOARD-003: 댓글 CRUD (1-depth 계층형)
-->
<mapper namespace="kr.co.ircp.cms.domain.board.repository.BbsCommentMapper">

    <resultMap id="bbsCommentResultMap" type="kr.co.ircp.cms.domain.board.entity.BbsComment">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="parentCommentId" column="parent_comment_id"/>
        <result property="authorId" column="author_id"/>
        <result property="authorUsername" column="author_username"/>
        <result property="anonymousName" column="anonymous_name"/>
        <result property="anonymousPwdHash" column="anonymous_pwd_hash"/>
        <result property="content" column="content"/>
        <result property="ipAddress" column="ip_address"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!--
        users 테이블 LEFT JOIN: 로그인 사용자 댓글에 authorUsername 을 함께 조회.
        익명 댓글(author_id IS NULL)은 author_username = NULL, anonymous_name 사용.
    -->
    <select id="findByPostId" resultMap="bbsCommentResultMap">
        SELECT c.*, u.username AS author_username
        FROM bbs_comment c
        LEFT JOIN users u ON u.id = c.author_id
        WHERE c.post_id = #{postId} AND c.status != 'DELETED'
        ORDER BY COALESCE(c.parent_comment_id, c.id), c.id
    </select>

    <select id="findById" resultMap="bbsCommentResultMap">
        SELECT c.*, u.username AS author_username
          FROM bbs_comment c
          LEFT JOIN users u ON u.id = c.author_id
         WHERE c.id = #{id} AND c.status != 'DELETED'
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bbs_comment (post_id, parent_comment_id, author_id,
            anonymous_name, anonymous_pwd_hash, content, ip_address, status)
        VALUES (#{postId}, #{parentCommentId}, #{authorId},
            #{anonymousName}, #{anonymousPwdHash}, #{content}, #{ipAddress, jdbcType=OTHER}, #{status})
    </insert>

    <update id="update">
        UPDATE bbs_comment SET
            content = #{content},
            status = #{status},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE bbs_comment SET status = 'DELETED', updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- ── 관리자 모더레이션 (SPEC-CMS-COMMENT-MODERATE-001) ──────────────────── -->

    <!--
        record 는 setter 가 없으므로 생성자 매핑 사용.
        컬럼 순서 = CommentAdminSummary(id, postId, postTitle, boardCode, boardName,
                                        authorUsername, contentPreview, status, createdAt) 와 일치.
    -->
    <resultMap id="commentAdminSummaryResultMap"
               type="kr.co.ircp.cms.domain.board.dto.CommentAdminSummary">
        <constructor>
            <idArg  column="id"              javaType="Long"              name="id"/>
            <arg    column="post_id"         javaType="Long"              name="postId"/>
            <arg    column="post_title"      javaType="String"            name="postTitle"/>
            <arg    column="board_code"      javaType="String"            name="boardCode"/>
            <arg    column="board_name"      javaType="String"            name="boardName"/>
            <arg    column="author_username" javaType="String"            name="authorUsername"/>
            <arg    column="content_preview" javaType="String"            name="contentPreview"/>
            <arg    column="status"          javaType="String"            name="status"/>
            <arg    column="created_at"      javaType="java.time.Instant" name="createdAt"/>
        </constructor>
    </resultMap>

    <!-- 공통 SELECT 절 (listForAdmin / findAdminSummaryById 공유) -->
    <sql id="adminSummarySelect">
        SELECT c.id,
               c.post_id,
               p.title                    AS post_title,
               m.code                     AS board_code,
               m.name                     AS board_name,
               u.username                 AS author_username,
               LEFT(c.content, 100)       AS content_preview,
               c.status,
               c.created_at
          FROM bbs_comment c
          JOIN bbs_post   p ON p.id   = c.post_id
          JOIN bbs_master m ON m.id   = p.bbs_id
          LEFT JOIN users u ON u.id   = c.author_id
    </sql>

    <!-- 공통 WHERE 절 (listForAdmin / countForAdmin 공유) -->
    <sql id="adminFilter">
        <where>
            <if test="req.boardId != null">
                AND m.id = #{req.boardId}
            </if>
            <if test="req.status != null and req.status != 'ALL'">
                AND c.status = #{req.status}
            </if>
            <if test="req.keyword != null and req.keyword != ''">
                AND (c.content ILIKE CONCAT('%', #{req.keyword}, '%')
                  OR u.username ILIKE CONCAT('%', #{req.keyword}, '%'))
            </if>
        </where>
    </sql>

    <!-- REQ-CMTM-001/002: 관리자용 댓글 목록 조회 (페이징) -->
    <select id="listForAdmin" resultMap="commentAdminSummaryResultMap">
        <include refid="adminSummarySelect"/>
        <include refid="adminFilter"/>
        ORDER BY c.created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- REQ-CMTM-001: 관리자용 댓글 전체 카운트 -->
    <select id="countForAdmin" resultType="long">
        SELECT COUNT(*)
          FROM bbs_comment c
          JOIN bbs_post   p ON p.id = c.post_id
          JOIN bbs_master m ON m.id = p.bbs_id
          LEFT JOIN users u ON u.id = c.author_id
        <include refid="adminFilter"/>
    </select>

    <!-- REQ-CMTM-003/004: 상태 변경 전 검증용 단건 status 조회 -->
    <select id="findStatusById" resultType="string">
        SELECT status FROM bbs_comment WHERE id = #{id}
    </select>

    <!-- REQ-CMTM-003: 상태 변경 후 응답용 단건 DTO 조회 -->
    <select id="findAdminSummaryById" resultMap="commentAdminSummaryResultMap">
        <include refid="adminSummarySelect"/>
        WHERE c.id = #{id}
    </select>

    <!-- REQ-CMTM-003: 댓글 상태 변경 (VISIBLE/HIDDEN) -->
    <update id="updateCommentStatus">
        UPDATE bbs_comment
           SET status     = #{status},
               updated_at = NOW()
         WHERE id = #{id}
    </update>

    <!-- REQ-CMTM-004: 관리자 소프트 삭제 -->
    <update id="adminSoftDelete">
        UPDATE bbs_comment
           SET status     = 'DELETED',
               deleted_at = NOW(),
               updated_at = NOW()
         WHERE id = #{id}
    </update>

</mapper>
